# Discord bot token. Never commit the real value.
DISCORD_TOKEN=your_bot_token

# Optional development guild for immediate slash-command synchronization.
DISCORD_GUILD_ID=

# Automatically clear stale commands from the opposite scope (global vs guild).
DISCORD_CLEAR_STALE_COMMANDS=true

# Application logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Change before exposing Grafana through a reverse proxy.
GRAFANA_ADMIN_PASSWORD=change_me
